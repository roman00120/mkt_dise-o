APP_NAME="TG Creative Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-DOMINIO.COM
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
ENABLE_DEMO_DATA=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanel_tgcreative
DB_USERNAME=cpanel_tgcreative
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
PRIVATE_FILESYSTEM_DISK=private
BACKUP_DISK=backups
BACKUP_RETENTION_DAYS=14
REPORT_RETENTION_DAYS=30
TEMP_FILE_RETENTION_HOURS=24
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=TU_SERVIDOR_SMTP
MAIL_PORT=587
MAIL_USERNAME=TU_CORREO@TU-DOMINIO.COM
MAIL_PASSWORD=CAMBIAR_ESTA_CONTRASENA
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@TU-DOMINIO.COM
MAIL_FROM_NAME="TG Creative Hub"

SECURITY_CSP="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"

VITE_APP_NAME="TG Creative Hub"
